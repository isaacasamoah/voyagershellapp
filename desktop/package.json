{
  "name": "voyager-desktop",
  "version": "0.1.0",
  "description": "A small Electron client of the Voyager Rust service",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs test/*.test.mjs",
    "proof": "electron . --proof",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "proof:whiteboard": "electron . --whiteboard-proof"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "44.7.0",
    "prettier": "3.9.9"
  },
  "private": true
}
