diff --git a/codex-rs/tui/src/voyager_bridge.rs b/codex-rs/tui/src/voyager_bridge.rs
new file mode 100644
index 0000000..ebdd219
--- /dev/null
+++ b/codex-rs/tui/src/voyager_bridge.rs
@@ -0,0 +1,53 @@
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+use std::fs;
+use std::io::{BufRead, BufReader, Read, Write};
+use std::os::unix::fs::{DirBuilderExt, MetadataExt, PermissionsExt};
+use std::os::unix::net::UnixListener;
+use std::path::PathBuf;
+use std::sync::{Arc, atomic::{AtomicBool, Ordering}, mpsc};
+use std::time::Duration;
+
+pub(crate) struct Bridge { path: PathBuf, stop: Arc<AtomicBool> }
+
+impl Drop for Bridge {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+        let _ = fs::remove_file(&self.path);
+    }
+}
+
+pub(crate) fn start(sender: AppEventSender) -> std::io::Result<Bridge> {
+    let uid = unsafe { libc::geteuid() };
+    let root = PathBuf::from(format!("/run/user/{uid}/codex-frontends"));
+    if !root.exists() { fs::DirBuilder::new().mode(0o700).create(&root)?; }
+    let meta = fs::symlink_metadata(&root)?;
+    if !meta.is_dir() || meta.uid() != uid || meta.mode() & 0o077 != 0 {
+        return Err(std::io::Error::other("Codex frontend directory is not private"));
+    }
+    let path = root.join(format!("{}.sock", std::process::id()));
+    let listener = UnixListener::bind(&path)?;
+    fs::set_permissions(&path, fs::Permissions::from_mode(0o600))?;
+    listener.set_nonblocking(true)?;
+    let stop = Arc::new(AtomicBool::new(false));
+    let stopping = stop.clone();
+    std::thread::spawn(move || {
+        while !stopping.load(Ordering::Relaxed) {
+            let Ok((mut stream, _)) = listener.accept() else {
+                std::thread::sleep(Duration::from_millis(25));
+                continue;
+            };
+            let _ = stream.set_read_timeout(Some(Duration::from_secs(1)));
+            let _ = stream.set_write_timeout(Some(Duration::from_secs(1)));
+            let mut line = String::new();
+            let Ok(_) = BufReader::new(&stream).take(64).read_line(&mut line) else { continue; };
+            if line != "snapshot\n" { continue; }
+            let (reply, response) = mpsc::sync_channel(1);
+            sender.send(AppEvent::VoyagerSnapshot { reply });
+            if let Ok(snapshot) = response.recv_timeout(Duration::from_secs(2)) {
+                let _ = writeln!(stream, "{snapshot}");
+            }
+        }
+    });
+    Ok(Bridge { path, stop })
+}
